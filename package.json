{
  "name": "zatca-simplified-invoice-sdk",
  "version": "0.1.0",
  "description": "Open-source TypeScript SDK for generating Saudi ZATCA simplified tax invoice TLV QR payloads.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "dev": "vitest"
  },
  "keywords": ["zatca", "invoice", "qr", "saudi", "tax"],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
